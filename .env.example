# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEYS: (Optional) Danh sách nhiều API Key phân tách bằng dấu phẩy để kích hoạt Round-Robin Key Rotation
# Ví dụ: GEMINI_API_KEYS="AIzaSyKey1...,AIzaSyKey2...,AIzaSyKey3..."
GEMINI_API_KEYS=

# Hoặc định nghĩa từng key riêng lẻ:
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

