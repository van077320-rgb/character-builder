# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
#
# Nhận cả hai định dạng khoá do AI Studio phát hành: "AIza..." (kiểu cũ) và
# "AQ..." (kiểu mới, là thứ nút Create API key trả về hiện nay).
# Chuỗi "ya29..." / "Bearer ..." là OAuth access token, KHÔNG dùng được.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEYS: (Optional) Danh sách nhiều API Key phân tách bằng dấu phẩy để kích hoạt Round-Robin Key Rotation
# Ví dụ: GEMINI_API_KEYS="AIzaSyKey1...,AQ.Key2...,AIzaSyKey3..."
# Lưu ý: hạn mức miễn phí tính theo (project x model x ngày), nên nhiều khoá cùng
# một Google Cloud project vẫn dùng chung một suất. Mỗi khoá một project mới thì
# hạn mức mới thực sự cộng dồn.
GEMINI_API_KEYS=

# Hoặc định nghĩa từng key riêng lẻ:
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

