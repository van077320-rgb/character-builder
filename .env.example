# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
#
# Nhận cả hai định dạng khoá do AI Studio phát hành: "AIza..." (kiểu cũ) và
# "AQ..." (kiểu mới, là thứ nút Create API key trả về hiện nay).
# Chuỗi "ya29..." / "Bearer ..." là OAuth access token, KHÔNG dùng được.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEYS: (Optional) Nhiều API Key trong MỘT biến để kích hoạt Round-Robin
# Key Rotation. Không giới hạn số lượng. Nhận dấu phẩy, chấm phẩy, gạch đứng hoặc
# xuống dòng làm dấu phân tách — key gom từ nhiều người gửi hiếm khi cùng định dạng.
# Ví dụ: GEMINI_API_KEYS=AIzaSyKey1...,AQ.Key2...,AIzaSyKey3...
#
# ⚠️ ĐỪNG bọc cả danh sách trong dấu nháy khi dán vào ô Environment Variables của
# Netlify. Dấu nháy chỉ là cú pháp của file .env, không phải của Netlify. Code có
# bóc dấu nháy ở hai đầu, nhưng dán sạch vẫn an toàn hơn.
#
# Lưu ý: hạn mức miễn phí tính theo (project x model x ngày), nên nhiều khoá cùng
# một Google Cloud project vẫn dùng chung một suất. Mỗi khoá một project mới thì
# hạn mức mới thực sự cộng dồn.
GEMINI_API_KEYS=

# Hoặc định nghĩa từng key riêng lẻ. Hỗ trợ GEMINI_API_KEY_1 đến GEMINI_API_KEY_50.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# ─────────────────────────────────────────────────────────────
# KEY DỰ PHÒNG (do người khác đóng góp)
#
# Key khai ở đây CHỈ được dùng khi toàn bộ key chính phía trên đã cạn hạn mức
# trên CẢ 5 tầng model. Nghĩa là hạn mức của người đóng góp chỉ bị tiêu khi
# thật sự hết đường — đổi lại, lúc đó người dùng nhận model yếu hơn thay vì
# tiêu key của người ta để lấy model mạnh.
#
# Xem key dự phòng đã bị dùng bao nhiêu lần: GET /api/gemini/status
#   → stats.reserveKeyUses   (0 = key của bạn vẫn gánh được hết)
#   → maskedKeys[].role      ("chính" / "dự phòng")
#
# Nhắc người đóng góp: tạo project MỚI và KHÔNG bật billing, nếu không họ có
# thể bị tính tiền thật khi vượt hạn mức miễn phí.
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEYS_RESERVE=

# Hoặc từng key riêng lẻ: GEMINI_API_KEY_RESERVE_1 đến _50
# (dạng số nhiều GEMINI_API_KEYS_RESERVE_1 cũng được nhận, để khỏi phải nhớ)
GEMINI_API_KEY_RESERVE_1=
GEMINI_API_KEY_RESERVE_2=

# Trần thời gian cho một lượt gọi trên serverless (ms). Netlify giết function ở
# giây thứ 60, nên mặc định 55000 để còn kịp trả về lỗi JSON đọc được.
# Chỉ áp dụng cho Netlify Functions; server Express (npm run dev / npm start)
# không bị trần này.
# FUNCTION_BUDGET_MS=55000

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

